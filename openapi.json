{
  "openapi": "3.0.0",
  "info": {
    "title": "Flashcards API",
    "version": "1.0.0",
    "description": "\nA REST API for creating decks of flashcards and studying them.\n\n**Stack:** Node.js, Express, TypeScript, Firebase (Firestore and Auth), Joi validation, Jest tests.\n\n### Authentication\nMost endpoints require a Firebase ID token, sent as a Bearer token in the\n`Authorization` header. <!-- FILL IN: how a visitor can get a token, or say which endpoints are public -->\n\n### Heads up\nThis API runs on a free hosting plan, so the first request after a quiet\nperiod can take up to a minute while the server wakes up.",
    "contact": {
      "name": "Leann Mekler",
      "url": "https://github.com/lmekler/flashcards_API"
    }
  },
  "servers": [
    {
      "url": "https://bed-capstone-project.onrender.com/api/v1",
      "description": "Live demo"
    },
    {
      "url": "http://localhost:3000/api/v1",
      "description": "Local server"
    }
  ],
  "tags": [
    {
      "name": "Decks",
      "description": "Create and manage decks of flashcards."
    },
    {
      "name": "Flashcards",
      "description": "Create and manage the cards inside a deck."
    },
    {
      "name": "Users",
      "description": "User accounts and profiles."
    },
    {
      "name": "Admin",
      "description": "Administrator-only operations."
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Deck": {
        "type": "object",
        "required": [
          "id",
          "userId",
          "visibility",
          "title",
          "description",
          "cardCount",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the deck.",
            "example": "bwCOdVm9LuiJycWyJNar"
          },
          "userId": {
            "type": "string",
            "description": "The ID of the user who owns the deck.",
            "example": "dxddMFNEukf56t6rSxvtdbSUWf23"
          },
          "visibility": {
            "type": "boolean",
            "description": "Whether the deck is private or public.",
            "example": true
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "description": "The title of the deck.",
            "example": "Human Biology Chapter 1"
          },
          "description": {
            "type": "string",
            "minLength": 0,
            "maxLength": 500,
            "default": "",
            "description": "A description of the deck.",
            "example": "The fundamentals of human biology, including cell structure, organelles, and their functions."
          },
          "cardCount": {
            "type": "integer",
            "default": 0,
            "description": "The amount of flashcards in the deck.",
            "example": 20
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp for when the deck was created.",
            "example": "2026-04-11T16:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp for last time the deck was updated.",
            "example": "2026-04-11T16:30:00Z"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "description": "Standard error response returned when an API request fails.",
        "required": [
          "success",
          "error",
          "timestamp"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Indicates whether the request was successful. Always false for an error response.",
            "example": false
          },
          "error": {
            "type": "object",
            "description": "Contains details about the error.",
            "required": [
              "message",
              "code"
            ],
            "properties": {
              "message": {
                "type": "string",
                "description": "A human-readable explanation of why the request failed.",
                "example": "Unauthorized: No token provided"
              },
              "code": {
                "type": "string",
                "description": "A machine-readable error code that identifies the type of failure.",
                "example": "TOKEN_NOT_FOUND"
              }
            }
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp for when the error occurred.",
            "example": "2026-11-20T20:00:00.000Z"
          }
        }
      },
      "Flashcard": {
        "type": "object",
        "required": [
          "id",
          "question",
          "answer",
          "isMastered",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique identifier for the flashcard.",
            "example": "ahBE4jNLYpjlSVGN71O1"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "description": "The question on the flashcard.",
            "example": "What is the main function of mitochondria?"
          },
          "answer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "description": "The answer on the flashcard.",
            "example": "Known as the powerhouse of the cell, mitochondria produce ATP through cellular respiration."
          },
          "isMastered": {
            "type": "boolean",
            "default": false,
            "description": "Whether the user has mastered this flashcard.",
            "example": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp for when the flashcard was created",
            "example": "2026-04-11T16:00:00Z"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp for last time the flashcard was updated",
            "example": "2026-04-11T16:30:00Z"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "description": "Standard successful API response.",
        "required": [
          "status",
          "data",
          "message"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "Indicates that the request was successful.",
            "enum": [
              "success"
            ],
            "example": "success"
          },
          "count": {
            "type": "integer",
            "description": "The total number of objects returned. Included when data is a list.",
            "example": 10
          },
          "data": {
            "description": "The data returned by the API endpoint. May be a single object or an array of objects."
          },
          "message": {
            "type": "string",
            "description": "A human-readable message describing the successful operation.",
            "example": "Decks retrieved successfully."
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "paths": {
    "/decks": {
      "post": {
        "summary": "Create a new deck.",
        "tags": [
          "Decks"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "title"
                ],
                "properties": {
                  "title": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 100,
                    "description": "The title of the deck.",
                    "example": "Human Biology Chapter 1"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500,
                    "description": "Optional description of the deck. If provided, it cannot be empty or contain only whitespace.",
                    "example": "The fundamentals of human biology, including cell structure, organelles, and their functions."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Deck created successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "$ref": "#/components/schemas/Deck"
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid input.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "Get a list of decks.",
        "tags": [
          "Decks"
        ],
        "responses": {
          "200": {
            "description": "Decks retrieved successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/SuccessResponse"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "data": {
                          "type": "array",
                          "description": "A list of decks.",
                          "items": {
                            "$ref": "#/components/schemas/Deck"
                          }
                        },
                        "count": {
                          "type": "integer",
                          "description": "The number of decks returned."
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
